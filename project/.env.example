PORT=3000
# Use a long random string in production.
JWT_SECRET=your_development_secret
# First admin account seeded by Admin.js
ADMIN_EMAIL=admin@smartsalon.com
ADMIN_PASS=admin123
# Set MOCK_SMS=false and configure SMS_PROVIDER + credentials to use a
# real SMS gateway. Leave as-is for local/college demonstration.
MOCK_SMS=true
SMS_PROVIDER=
REMINDER_MINUTES=60
REMINDER_MINUTES_SECOND=30
GRACE_PERIOD_MINUTES=15
TIMEZONE=Asia/Kolkata
